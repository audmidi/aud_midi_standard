{
  "name": "aud_midi_standard",
  "summary": "MIDI 1.0 and MIDI 2.0 (UMP) standards as dependency-free Dart: messages, constants, codecs, translation, models.",
  "domain": [
    "MIDI 1.0 bytes, UMP MT0-MTF, M2-104-UM translation, BLE-MIDI framing",
    "Descriptive models: ports, devices, capabilities, events, diagnostics, MidiKey (channel, note), MidiNote (channel, note, velocity), ChannelVelocity (channel, velocity); MidiMessageCallback for receivers of message lists",
    "Successor of gg_midi_vars (MidiNoteNumbers, MidiControllers)"
  ],
  "interfaces": {
    "uses": {},
    "usedBy": {
      "aud_midi_core": "MidiMessage, MidiPacket, models, codecs in pipelines",
      "aud_midi_rtp": "MIDI 1.0 messages, MidiByteEncoder/Parser",
      "aud_midi_network": "messages, models",
      "aud_midi": "re-exports the whole API",
      "aud_midi_state_matrix": "MidiMessage, MidiNoteOn, MidiNoteOff, MidiControlChange, MidiKey, MidiMessageCallback",
      "aud_tone_selection": "ChannelVelocity voices, MidiNote of the selected cells",
      "aud_playing_cells": "MidiNote, MidiKey, MidiNoteOn, MidiNoteOff, MidiMessageCallback",
      "aud_midi_apple, aud_midi_android, aud_midi_windows, aud_midi_linux, aud_midi_web": "models, MidiPacket, Ump, MidiBytes"
    }
  }
}
